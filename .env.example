# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# wind-ui mode flag (same routine as tackle-ui):
#   VITE_WIND_MODE=mock  -> serves the SPA on :3000, client-side mockBackend handles all data
#   VITE_WIND_MODE=live  -> serves on :4209 and proxies to the two real backends:
#     /api/* + /health          -> wind-srv   (nexus.wind schema, default http://localhost:3300)
#     /config/ai/*, /tasks, /sessions, /scheduler, /memory/*, /prompts/*, /config/failure-recovery
#                               -> tackle-srv (default http://localhost:3410)
VITE_WIND_MODE=mock

# Live-mode backend targets (only used when VITE_WIND_MODE=live)
VITE_WIND_SRV_TARGET=http://localhost:3300
VITE_TACKLE_SRV_TARGET=http://localhost:3410
