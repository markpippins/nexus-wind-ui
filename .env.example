# wind-ui runtime configuration (LAC — architect thread 83d2fd5c)
#
# Mode authority: VITE_WIND_MODE. Values: live | mock.
#   - live (default): all reads go to wind-srv/tackle-srv; failures surface
#     as visible errors, never fixture fallbacks.
#   - mock: explicit opt-in only; in-browser simulated backend.
# localStorage/sessionStorage are never consulted for mode.

# Mode (live | mock) — production default live
VITE_WIND_MODE=live

# Service endpoints (documented defaults; runtime terrain lookup refines)
VITE_LOOKUP_URL=http://localhost:8084
VITE_WIND_SRV_TARGET=http://localhost:3300
VITE_TACKLE_SRV_TARGET=http://localhost:3410
